# Copy to bot.env (never commit it). Only VIDYA_BOT_TOKEN and GROQ_API_KEY are required.
# Comments must be on their own line: Docker --env-file treats anything after "=" as the value.

# From @BotFather /newbot. Use a NEW bot, not any other bot's token.
VIDYA_BOT_TOKEN=
# console.groq.com (free): answers + voice-note transcription
GROQ_API_KEY=
# Optional: reads photos of questions, and answers when Groq's daily limit runs out
NEBIUS_API_KEY=
# Optional: second backup for answers and photos
NVIDIA_API_KEY=
# Your Telegram user id(s), comma separated, for /stats
BOT_ADMIN_IDS=

# Daily limits (defaults shown). They keep one heavy user from using up the shared free quota.
BOT_CAP_PER_USER=30
BOT_CAP_VOICE=15
BOT_CAP_PHOTO=8
BOT_CAP_QUIZ=6
BOT_CAP_GLOBAL=600
