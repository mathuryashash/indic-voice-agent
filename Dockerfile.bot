# Vidya Saathi Telegram bot. Long polling: needs outbound internet only (no public URL, no HTTPS setup).
# Build: docker build -f Dockerfile.bot -t vidya-bot .
# Run:   docker run -d --restart unless-stopped --env-file bot.env -v vidya-data:/data vidya-bot
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 STT_BACKEND=groq BOT_DB=/data/bot.sqlite REMINDERS_DB=/data/reminders.sqlite
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 user && mkdir /data && chown user /data
WORKDIR /home/user/app
COPY requirements-cloud.txt requirements-bot.txt ./
RUN pip install -r requirements-bot.txt
COPY --chown=user app ./app
USER user
VOLUME /data
CMD ["python", "-m", "app.telegram_bot"]
